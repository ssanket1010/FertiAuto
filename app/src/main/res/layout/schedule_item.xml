<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="16dp"
    android:layout_marginTop="10dp">

    <!-- Top row: Title + Date/Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMotor"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Schedule"
            android:textColor="#263238"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWhen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025-12-04 | 14:00"
            android:textColor="#455A64"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Levels display -->
    <TextView
        android:id="@+id/tvLevels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M1:0%  M2:0%  M3:0%"
        android:textSize="14sp"
        android:textColor="#546E7A"
        android:layout_marginTop="6dp"/>

    <!-- Repeat label -->
    <TextView
        android:id="@+id/tvRepeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeat: Once"
        android:layout_marginTop="6dp"
        android:textColor="#607D8B"
        android:textSize="14sp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRunNow"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Run Now"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#388E3C"
            android:textSize="13sp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>