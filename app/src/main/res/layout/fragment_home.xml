<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Welcome title -->
        <TextView
            android:id="@+id/welcomeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Yash"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#263238"/>

        <TextView
            android:id="@+id/homeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weather  field overview"
            android:textSize="14sp"
            android:textColor="#546E7A"
            android:layout_marginTop="4dp"/>

        <!-- WEATHER CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/weatherCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true">

            <GridLayout
                android:id="@+id/weatherGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:padding="16dp"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- Temperature -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconTemp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_wb_sunny"
                        android:contentDescription="temperature icon" />

                    <TextView
                        android:id="@+id/homeTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21.3 °C"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="12dp"
                        android:textColor="#263238"/>
                </LinearLayout>

                <!-- Humidity -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconHumidity"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_opacity"
                        android:contentDescription="humidity icon" />

                    <TextView
                        android:id="@+id/homeHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Humidity: 83%"
                        android:layout_marginStart="12dp"
                        android:textColor="#263238"/>
                </LinearLayout>

                <!-- Wind -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconWind"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_air"
                        android:contentDescription="wind icon" />

                    <TextView
                        android:id="@+id/homeWind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wind: 5.0 m/s"
                        android:layout_marginStart="12dp"
                        android:textColor="#263238"/>
                </LinearLayout>

                <!-- Rain -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/iconRain"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_grain"
                        android:contentDescription="rain icon" />

                    <TextView
                        android:id="@+id/homeRain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rain: 0.0 mm"
                        android:layout_marginStart="12dp"
                        android:textColor="#263238"/>
                </LinearLayout>

            </GridLayout>
        </androidx.cardview.widget.CardView>

        <!-- TIP CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tipCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iconTip"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_lightbulb"
                    android:contentDescription="tip icon" />

                <TextView
                    android:id="@+id/homeTip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Tip: Check moisture and pH before scheduling fertilizer."
                    android:textColor="#263238"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- UPCOMING SCHEDULES CARD -->
        <!-- UPCOMING SCHEDULES CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/upcomingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Tasks"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:textSize="18sp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>