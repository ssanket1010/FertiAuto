<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Welcome title -->
        <TextView
            android:id="@+id/welcomeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Namaskar, Krishi"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#263238"/>

        <TextView
            android:id="@+id/homeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Overview"
            android:textSize="14sp"
            android:textColor="#546E7A"
            android:layout_marginTop="2dp"/>

        <!-- LOCATION CHIP -->
        <LinearLayout
            android:id="@+id/locationChip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginTop="10dp"
            android:elevation="3dp">

            <ImageView
                android:id="@+id/iconLocation"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location"
                app:tint="#D84315"/>

            <TextView
                android:id="@+id/homeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dharwad, Karnataka"
                android:textSize="14sp"
                android:textColor="#263238"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- WEATHER CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/weatherCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="12dp">

                <!-- Temperature -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iconTemp"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_wb_sunny"/>

                    <TextView
                        android:id="@+id/homeTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21.3 °C"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_marginStart="10dp"
                        android:textColor="#263238"/>
                </LinearLayout>

                <!-- Humidity -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iconHumidity"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_opacity"/>

                    <TextView
                        android:id="@+id/homeHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Humidity: 83%"
                        android:layout_marginStart="10dp"
                        android:textColor="#263238"/>
                </LinearLayout>

                <!-- Wind -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iconWind"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_air"/>

                    <TextView
                        android:id="@+id/homeWind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wind: 5.0 m/s"
                        android:layout_marginStart="10dp"
                        android:textColor="#263238"/>
                </LinearLayout>

                <!-- Rain -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iconRain"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_grain"/>

                    <TextView
                        android:id="@+id/homeRain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rain: 0.0 mm"
                        android:layout_marginStart="10dp"
                        android:textColor="#263238"/>
                </LinearLayout>

            </GridLayout>
        </androidx.cardview.widget.CardView>

        <!-- TIP CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tipCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iconTip"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_lightbulb"/>

                <TextView
                    android:id="@+id/homeTip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Combine organic + chemical fertilizers for best results."
                    android:textColor="#263238"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SOIL STATUS CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/soilStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Soil Status"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:textSize="16sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <!-- pH -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconPh"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_ph"/>

                        <TextView
                            android:id="@+id/homePh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="pH: 7"
                            android:textSize="15sp"
                            android:textColor="#263238"/>
                    </LinearLayout>

                    <!-- Moisture -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconMoisture"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_moisture"/>

                        <TextView
                            android:id="@+id/homeMoisture"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Moisture: 9%"
                            android:textSize="15sp"
                            android:textColor="#263238"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- UPCOMING TASKS CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/upcomingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Tasks"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:textSize="16sp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <!-- MEMORY SCHEDULING CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/memorySchedulingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/memoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memory Scheduling"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:textSize="16sp"/>

                <!-- Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnM1"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="M1"
                        android:textAllCaps="false"
                        android:backgroundTint="#1976D2"
                        android:textColor="#FFFFFF"/>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btnM2"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="M2"
                        android:textAllCaps="false"
                        android:backgroundTint="#1976D2"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>